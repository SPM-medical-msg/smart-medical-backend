server.port=9001
spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/doctor11?useUnicode=true&useJDBCCompliantTimezoneShift=true&useLegacyDatetimeCode=false&serverTimezone=Asia/Shanghai
spring.datasource.username=your_username
spring.datasource.password=your_password
mybatis-plus.mapper-locations=classpath:mapper/*.xml

# 文件上传路径（请根据实际情况修改）
file.path=D:/image/

# 阿里云OSS配置（请填入自己的密钥）
spring.cloud.alicloud.access-key=your_access_key
spring.cloud.alicloud.secret-key=your_secret_key
spring.cloud.alicloud.oss.endpoint=oss-cn-hangzhou.aliyuncs.com

spring.servlet.multipart.max-file-size=100MB
spring.servlet.multipart.max-request-size=1000MB

# MQTT配置
spring.mqtt.username=server
spring.mqtt.password=password
spring.mqtt.url=tcp://127.0.0.1:1883
spring.mqtt.client.id=${random.value}
spring.mqtt.default.topic=test
spring.mqtt.completionTimeout=3000
spring.mqtt.qos=0

